# Copiez ce fichier en .env et remplissez les valeurs. Le fichier .env n'est jamais versionné.
# Les variables d'environnement définies au lancement l'emportent sur ce fichier.

# IA utilisée pour comprendre les réponses : openai (tout fournisseur compatible avec l'API
# OpenAI : Albert API de l'État par défaut, ou une passerelle comme LiteLLM) ou anthropic (Claude).
LLM_PROVIDER=openai

# Fournisseur compatible OpenAI : clé personnelle et modèle.
# Par défaut : Albert API de l'État (clé à demander à Etalab).
OPENAI_API_KEY=
OPENAI_MODEL=albert-large
# OPENAI_BASE_URL=https://albert.api.etalab.gouv.fr/v1
# Pour utiliser une autre passerelle compatible OpenAI (par exemple LiteLLM), changer les trois
# valeurs ci-dessus : OPENAI_BASE_URL (URL de l'instance), OPENAI_API_KEY, OPENAI_MODEL.

# Claude (si LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# Accès protégé pour les tests à distance (laisser vide pour un accès libre en local).
ACCES_IDENTIFIANT=
ACCES_MOT_DE_PASSE=
