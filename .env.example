# Copiez ce fichier en .env et remplissez les valeurs. Le fichier .env n'est jamais versionné.
# Les variables d'environnement définies au lancement l'emportent sur ce fichier.

# IA utilisée pour comprendre les réponses : albert (IA de l'État) ou anthropic (Claude).
LLM_PROVIDER=albert

# Albert API : clé personnelle, à demander à Etalab.
ALBERT_API_KEY=
ALBERT_MODEL=albert-large
# ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1

# Claude (si LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# Accès protégé pour les tests à distance (laisser vide pour un accès libre en local).
ACCES_IDENTIFIANT=
ACCES_MOT_DE_PASSE=
